# Copy to .env and fill in: `cp .env.example .env`. Then run with `uv run --env-file .env …`.
# .env is git-ignored. Never commit it, and never put a real value in this template.

# Anthropic API key: required for `triage run`. Use a key dedicated to this project, with a
# monthly spend limit set in the Anthropic console. (ANTHROPIC_AUTH_TOKEN also works instead.)
ANTHROPIC_API_KEY=

# Langfuse tracing: optional, but all-or-nothing. Set all three, or leave all three empty for
# untraced runs. Keys only work in the Langfuse region that issued them, so the URL must be that
# region's: US https://us.cloud.langfuse.com, EU https://cloud.langfuse.com.
# (The older LANGFUSE_HOST is still accepted in place of LANGFUSE_BASE_URL.)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
